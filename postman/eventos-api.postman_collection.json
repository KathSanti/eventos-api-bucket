    {
      "name": "5. Ataques al token",
      "item": [
        {
          "name": "Token alterado (espera 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "me"
              ]
            },
            "description": "El script previo cambia una letra del payload del token: la firma deja de coincidir.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlterado}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get(\"token\") || \"\";",
                  "const p = t.split(\".\");",
                  "if (p.length === 3) { p[1] = (p[1][0] === \"a\" ? \"b\" : \"a\") + p[1].slice(1); }",
                  "pm.collectionVariables.set(\"tokenAlterado\", p.join(\".\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Resumen de compra y AWS S3",
      "description": "Ejecuta antes '3. Cliente autenticado > Comprar entradas' (guarda {{numeroResumen}}). Requiere credenciales de AWS Academy vigentes en .env.",
      "item": [
        {
          "name": "1. Generar resumen (archivo físico)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/compras/{{numeroResumen}}/resumen",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{numeroResumen}}",
                "resumen"
              ]
            },
            "description": "En Postman: flecha junto a Send -> 'Send and Download' para guardarlo en tu computador.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Viene como archivo adjunto\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Subir resumen a S3",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/compras/{{numeroResumen}}/resumen/s3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{numeroResumen}}",
                "resumen",
                "s3"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Queda en la carpeta del número de resumen\", () => {",
                  "  const n = pm.collectionVariables.get(\"numeroResumen\");",
                  "  pm.expect(pm.response.json().carpeta).to.eql(n + \"/\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Descargar resumen desde S3",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
