# Copia este archivo como ".env" y completa los valores. NUNCA subas .env a GitHub.
# Genera la clave JWT con:  openssl rand -base64 32
JWT_SECRET=
ADMIN_EMAIL=admin@eventos.local
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# AWS Academy (Learner Lab -> AWS Details -> AWS CLI). Cambian en cada sesión.
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Base de datos MySQL (solo para docker compose)
DB_PASSWORD=

# IPs desde las que el ADMIN puede entrar (vacío = cualquiera). Ej: 127.0.0.1,::1 para probar en local
ADMIN_ALLOWED_IPS=
